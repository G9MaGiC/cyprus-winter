# Cyprus Winter — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.

# Required for core features
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cyprus Winter <bookings@example.com>
ADMIN_SECRET=
# HEALTH_SECRET=used to authorize detailed production health diagnostics

# AI chat — Vercel AI Gateway is tried first in code (single key, multi-model routing).
# Docs: https://vercel.com/docs/ai-gateway/getting-started
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=openai/gpt-4o-mini

# AI chat (add at least one direct provider if not using the gateway)
# OPENAI_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# MOONSHOT_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# Required for production (shared rate limiting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Sentry error monitoring (optional — required for source map uploads in CI)
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_DEBUG=1  # opt-in verbose Sentry logs (off by default — floods next dev)

# Optional — public origin for canonical/OG/email absolute URLs.
# Defaults to the live Vercel alias until cypruswinter.com DNS is attached.
# NEXT_PUBLIC_SITE_URL=https://cyprus-winter-three.vercel.app
# CAPACITOR_SERVER_URL=https://cyprus-winter-three.vercel.app
# CRON_SECRET=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_MAILTO=

# Signed email links to load bookings without signing in (min 16 characters).
# Optional: signed-in users can still load bookings. Required to send lookup links.
# BOOKING_LOOKUP_TOKEN_SECRET=

# Shared secret for /partner (min 16 characters). Pair with verified partnerEmail on wineries/guides.
# PARTNER_PORTAL_SECRET=

# NEVER set in production — bypasses rate limits for load testing only
# STRESS_TEST_TOKEN=

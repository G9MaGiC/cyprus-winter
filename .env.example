# Cyprus Winter — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.

# Required for core features
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cyprus Winter <bookings@example.com>
ADMIN_SECRET=

# AI chat (add at least one)
# OPENAI_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# MOONSHOT_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# Required for production (shared rate limiting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Sentry error monitoring (optional — required for source map uploads in CI)
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Optional
# NEXT_PUBLIC_SITE_URL=https://cypruswinter.com
# CRON_SECRET=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_MAILTO=

# NEVER set in production — bypasses rate limits for load testing only
# STRESS_TEST_TOKEN=

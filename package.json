{
  "name": "cyprus-winter",
  "version": "2.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/G9MaGiC/cyprus-winter.git"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "prebuild": "node scripts/check-build-dir.mjs",
    "build": "next build",
    "build:clean": "rm -rf dist .next .next-build && npm run build",
    "build:docker": "DOCKER_BUILD=true npm run build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "CI=true PORT=3001 playwright test",
    "stress:api": "node scripts/stress-test-apis.mjs",
    "analyze": "ANALYZE=true npm run build",
    "analyze:old": "next experimental-analyze",
    "data:export": "npx tsx scripts/enrich-places/export-places.ts",
    "i18n:extract": "npx tsx scripts/i18n/extract.ts",
    "i18n:validate": "npx tsx scripts/i18n/validate-messages.ts",
    "data:enrich": "npx tsx scripts/enrich-places/enrich.ts",
    "vapid-keys": "npx web-push generate-vapid-keys",
    "android:sync": "cap sync android",
    "android:build:debug": "cd android && ./gradlew assembleDebug",
    "android:build:release": "cap build android --androidreleasetype AAB"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.43.0",
    "@supabase/supabase-js": "^2.98.0",
    "@swc/helpers": "0.5.19",
    "@tanstack/react-query": "^5.90.21",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "openai": "^6.25.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.9.3",
    "web-push": "^3.6.7",
    "web-vitals": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/android": "^7.3.0",
    "@capacitor/cli": "^7.3.0",
    "@capacitor/core": "^7.3.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
